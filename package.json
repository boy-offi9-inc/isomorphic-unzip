{
  "name": "@boy-offi9-inc/isomorphic-unzip",
  "version": "0.1.0",
  "description": "Maintained drop-in replacement for the abandoned isomorphic-unzip — same API (getBuffer, string/RegExp/function matching), powered internally by fflate instead of a yauzl+zip.js split that never actually reached parity between Node and browser.",
  "main": "./src/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "browser": "./src/index.browser.js",
      "require": "./src/index.js",
      "import": "./src/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "test": "node --test"
  },
  "keywords": [
    "unzip",
    "zip",
    "isomorphic",
    "browser",
    "node",
    "apk",
    "ipa",
    "archive"
  ],
  "author": "Boy Offi9",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "fflate": "^0.8.2"
  },
  "files": [
    "src",
    "types",
    "README.md",
    "LICENSE"
  ]
}
